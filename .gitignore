# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE / Editor
.vscode/
.idea/

# Data: raw audio/charts and preprocessing output move with rsync, never git.
# data/splits/ (manifest + split.json) is committed so splits are reproducible.
data/raw/
data/processed/

# Checkpoints and generated charts
outputs/
*.pt

# Playground is scratch space; only its README and the toy dataset are tracked
playground/*
!playground/README.md
!playground/toy_dataset/
playground/toy_dataset/processed/

# Logs / temporary files
*.log
*.tmp

*.zip
